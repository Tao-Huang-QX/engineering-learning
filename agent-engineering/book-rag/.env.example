# Embeddings: HuggingFace model id, downloaded locally on first use.
# Multilingual default so it works regardless of the book's language.
BOOK_RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM for answer synthesis (and later the LangGraph agent).
# Leave key empty to work offline (ingest/retrieve/eval need no LLM).
BOOK_RAG_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Postgres/pgvector (compose maps host port 5433 -> container 5432)
BOOK_RAG_PG_HOST=localhost
BOOK_RAG_PG_PORT=5433
BOOK_RAG_PG_DB=book_rag
BOOK_RAG_PG_USER=postgres
BOOK_RAG_PG_PASSWORD=postgres

# Retrieval
BOOK_RAG_TOP_K=5
